{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/data/**": true,
    "**/results/**": true,
    "**/analysis/**": true,
    "**/.git/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/data": true,
    "**/results": true,
    "**/analysis": true,
    "**/__pycache__": true
  },
  "python.analysis.exclude": [
    "**/.venv",
    "**/data",
    "**/results",
    "**/analysis"
  ],
  "python.defaultInterpreterPath": ".venv/bin/python"
}
